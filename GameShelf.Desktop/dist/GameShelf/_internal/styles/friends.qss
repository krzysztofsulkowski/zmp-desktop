QWidget#friendsView {
    background: transparent;
}

QLabel#friendsPageTitle {
    color: #ffffff;
    background: transparent;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 29px;
    font-weight: 900;
}

QFrame#friendsCard {
    background-color: rgba(9, 4, 17, 0.18);
    border: 1px solid #8B5CF6;
    border-radius: 22px;
}

QLabel#friendsSectionTitle {
    color: #ffffff;
    background: transparent;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 18px;
    font-weight: 900;
}

QLabel#friendsHintLabel,
QLabel#friendsStatusLabel {
    color: #CBC3DF;
    background: transparent;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 13px;
    font-weight: 500;
}

QLineEdit#friendsSearchInput {
    background-color: #ffffff;
    color: #18181b;
    border: 1px solid #8B5CF6;
    border-radius: 12px;
    padding: 11px 14px;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 14px;
}

QLineEdit#friendsSearchInput:focus {
    border: 1px solid #A78BFA;
}

QPushButton#friendsPrimaryButton,
QPushButton#friendsSecondaryButton,
QPushButton#friendsDangerButton {
    color: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 11px 16px;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 14px;
    font-weight: 900;
}

QPushButton#friendsPrimaryButton {
    background-color: #7C3AED;
}

QPushButton#friendsPrimaryButton:hover {
    background-color: #8B5CF6;
}

QPushButton#friendsSecondaryButton {
    background-color: #5C4E7E;
}

QPushButton#friendsSecondaryButton:hover {
    background-color: #66558d;
}

QPushButton#friendsDangerButton {
    background-color: rgba(239, 68, 68, 0.18);
    border: 1px solid rgba(239, 68, 68, 0.50);
    color: #fecaca;
}

QPushButton#friendsDangerButton:hover {
    background-color: rgba(239, 68, 68, 0.32);
}

QListWidget#friendsList,
QListWidget#friendsCompareList {
    background-color: rgba(17, 17, 32, 0.78);
    color: #ffffff;
    border: 1px solid rgba(139, 92, 246, 0.55);
    border-radius: 16px;
    padding: 8px;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 14px;
    outline: none;
}

QListWidget#friendsList::item,
QListWidget#friendsCompareList::item {
    color: #ffffff;
    padding: 10px 12px;
    border-radius: 10px;
}

QListWidget#friendsList::item:hover,
QListWidget#friendsCompareList::item:hover {
    background-color: rgba(139, 92, 246, 0.18);
}

QListWidget#friendsList::item:selected,
QListWidget#friendsCompareList::item:selected {
    background-color: rgba(139, 92, 246, 0.42);
    color: #ffffff;
}

QFrame#compareResultItem {
    background-color: rgba(92, 78, 126, 0.25);
    border: 1px solid rgba(139, 92, 246, 0.45);
    border-radius: 14px;
}

QLabel#compareResultTitle {
    color: #ffffff;
    background: transparent;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 15px;
    font-weight: 900;
}

QLabel#compareResultMeta {
    color: #CBC3DF;
    background: transparent;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 12px;
    font-weight: 500;
}

QLabel#compareChip {
    color: #ffffff;
    background-color: rgba(124, 58, 237, 0.65);
    border: 1px solid rgba(167, 139, 250, 0.55);
    border-radius: 10px;
    padding: 5px 10px;
    margin: 0px;
    min-height: 30px;
    font-family: "Figtree SemiBold", "Figtree", "Segoe UI", "Arial";
    font-size: 12px;
    font-weight: 700;
}

QFrame#compareResultItem {
    padding-bottom: 6px;
}

QListWidget#friendsCompareList::item {
    margin: 4px 0px;
}
