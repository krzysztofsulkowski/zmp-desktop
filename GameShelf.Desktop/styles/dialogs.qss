QDialog {
    background-color: #0f0f1a;
}

QDialog QLabel {
    color: #f8fafc;
}

QDialog QPushButton {
    border-radius: 12px;
    padding: 10px 14px;
    font-weight: 800;
}

QDialog QLineEdit,
QDialog QTextEdit,
QDialog QPlainTextEdit,
QDialog QComboBox {
    background-color: #ffffff;
    color: #18181b;
    border: 1px solid #e4e4e7;
    border-radius: 12px;
    padding: 10px 14px;
}

QDialog QListWidget {
    background-color: #151527;
    color: #f8fafc;
    border: 1px solid rgba(124, 58, 237, 0.35);
    border-radius: 14px;
}

QWidget#profileView {
    background: transparent;
}

QFrame#profileContentFrame {
    background-color: transparent;
    border: none;
}

QLabel#profilePageTitle {
    color: #ffffff;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 29px;
    font-weight: 900;
}

QLabel#profileAvatar {
    background-color: #21153B;
    color: #CBC3DF;
    border: 1px solid #8B5CF6;
    border-radius: 75px;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 13px;
}

QLabel#profileEmail {
    color: #ffffff;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 17px;
    font-weight: 500;
}

QLabel#profileUsername {
    color: #CBC3DF;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 21px;
    font-weight: 800;
}

QPushButton#profileEditButton {
    background-color: #5C4E7E;
    color: #ffffff;
    border: none;
    border-radius: 9px;
    padding: 9px 14px;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 14px;
    font-weight: 800;
}

QPushButton#profileEditButton:hover {
    background-color: #66558d;
}

QFrame#profileBioBox {
    background-color: rgba(9, 4, 17, 0.18);
    border: 1px solid #8B5CF6;
    border-radius: 22px;
}

QLabel#profileBioTitle {
    color: #ffffff;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 27px;
    font-weight: 900;
}

QLabel#profileBioText {
    color: #ffffff;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 16px;
    font-weight: 400;
    line-height: 22px;
}

QDialog#editProfileDialog {
    background: transparent;
}

QFrame#editProfileDialogFrame {
    background-color: #111120;
    border: 1px solid #8B5CF6;
    border-radius: 22px;
}

QLabel#editProfileDialogTitle {
    color: #ffffff;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 24px;
    font-weight: 900;
}

QPushButton#editProfileCloseButton {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 11px;
    font-size: 20px;
    font-weight: 900;
    padding: 0px;
}

QPushButton#editProfileCloseButton:hover {
    background-color: #ef4444;
    color: #ffffff;
}

QLineEdit#editProfileInput,
QTextEdit#editProfileTextArea {
    background-color: #ffffff;
    color: #18181b;
    border: 1px solid #8B5CF6;
    border-radius: 18px;
    padding: 10px 14px 16px 14px;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 14px;
}

QLabel#editProfileFileLabel {
    color: #CBC3DF;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 13px;
}

QPushButton#editProfilePrimaryButton,
QPushButton#editProfileSecondaryButton {
    background-color: #7C3AED;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 11px 16px;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 14px;
    font-weight: 900;
}

QPushButton#editProfilePrimaryButton:hover,
QPushButton#editProfileSecondaryButton:hover {
    background-color: #8B5CF6;
}


QDialog#editProfileDialog QLabel {
    color: #D8CCFF;
    font-family: "Figtree SemiBold", "Figtree", "Segoe UI", "Arial";
    font-size: 14px;
    font-weight: 700;
}

QLabel#editProfileDialogTitle {
    color: #ffffff;
}

QLabel#editProfileFileLabel {
    color: #A78BFA;
    font-family: "Figtree SemiBold", "Figtree", "Segoe UI", "Arial";
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QFrame#styledDialogFrame,
QFrame#styledMessageFrame {
    background-color: #111120;
    border: 1px solid #8B5CF6;
    border-radius: 22px;
}

QLabel#styledDialogTitle,
QLabel#styledMessageTitle {
    color: #ffffff;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 20px;
    font-weight: 900;
}

QPushButton#styledDialogCloseButton {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 11px;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 20px;
    font-weight: 900;
    padding: 0px;
}

QPushButton#styledDialogCloseButton:hover {
    background-color: #ef4444;
    color: #ffffff;
}

QWidget#styledDialogBody QLabel,
QLabel#styledMessageText {
    color: #D8CCFF;
    font-family: "Figtree SemiBold", "Figtree", "Segoe UI", "Arial";
    font-size: 14px;
    font-weight: 700;
}

QWidget#styledDialogBody QLineEdit,
QWidget#styledDialogBody QTextEdit,
QWidget#styledDialogBody QComboBox,
QWidget#styledDialogBody QListWidget {
    background-color: #ffffff;
    color: #18181b;
    border: 1px solid #8B5CF6;
    border-radius: 14px;
    padding: 10px 14px;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 14px;
}

QWidget#styledDialogBody QListWidget {
    background-color: #151527;
    color: #f8fafc;
}

QWidget#styledDialogBody QCheckBox {
    color: #D8CCFF;
    font-family: "Figtree SemiBold", "Figtree", "Segoe UI", "Arial";
    font-size: 14px;
    font-weight: 700;
}

QWidget#styledDialogBody QPushButton,
QPushButton#styledMessageButton {
    background-color: #7C3AED;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 11px 16px;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 14px;
    font-weight: 900;
}

QWidget#styledDialogBody QPushButton:hover,
QPushButton#styledMessageButton:hover {
    background-color: #8B5CF6;
}

QLabel#styledMessageWarningIcon {
    background-color: #FACC15;
    color: #111120;
    border-radius: 17px;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 22px;
    font-weight: 900;
}

QLabel#styledMessageInfoIcon {
    background-color: #0EA5E9;
    color: #ffffff;
    border-radius: 17px;
    font-family: "Figtree ExtraBold", "Figtree", "Segoe UI", "Arial";
    font-size: 20px;
    font-weight: 900;
}
