QDialog {
    background-color: #0f0f1a;
}

QDialog QLabel {
    color: #f8fafc;
}

QDialog QPushButton {
    border-radius: 12px;
    padding: 10px 14px;
    font-weight: 800;
}

QDialog QLineEdit,
QDialog QTextEdit,
QDialog QPlainTextEdit,
QDialog QComboBox {
    background-color: #ffffff;
    color: #18181b;
    border: 1px solid #e4e4e7;
    border-radius: 12px;
    padding: 10px 14px;
}

QDialog QListWidget {
    background-color: #151527;
    color: #f8fafc;
    border: 1px solid rgba(124, 58, 237, 0.35);
    border-radius: 14px;
}
