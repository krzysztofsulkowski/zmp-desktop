QWidget {
    background-color: #0f0f1a;
    color: #f8fafc;
    font-family: "Figtree", "Segoe UI", "Arial";
}

QFrame#landingFrame {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 1,
        y2: 0,
        stop: 0 #10101c,
        stop: 0.36 #151125,
        stop: 0.58 #24134a,
        stop: 0.78 #3b1d73,
        stop: 1 #180f2c
    );
    border: 1px solid rgba(139, 92, 246, 0.95);
    border-radius: 28px;
}

QPushButton#landingLoginButton {
    background: transparent;
    color: #ffffff;
    border: none;
    border-radius: 18px;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.4px;
    padding: 0;
}

QPushButton#landingLoginButton:hover {
    background-color: rgba(124, 58, 237, 0.18);
}

QPushButton#landingRegisterButton {
    background-color: #7C3AED;
    color: #ffffff;
    border: none;
    border-radius: 13px;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.4px;
    padding: 0;
}

QPushButton#landingRegisterButton:hover {
    background-color: #8B5CF6;
}

QPushButton#landingJoinButton {
    background-color: #7C3AED;
    color: #ffffff;
    border: none;
    border-radius: 13px;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.4px;
    padding: 0;
}

QPushButton#landingJoinButton:hover {
    background-color: #8B5CF6;
}

QPushButton#windowControlButton,
QPushButton#windowCloseButton {
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 15px;
    font-weight: 900;
    padding: 0;
}

QPushButton#windowControlButton:hover {
    background-color: rgba(124, 58, 237, 0.32);
    border: 1px solid rgba(139, 92, 246, 0.70);
}

QPushButton#windowCloseButton:hover {
    background-color: #ef4444;
    border: 1px solid #ef4444;
    color: #ffffff;
}

QLabel#landingLogo {
    background-color: transparent;
    color: #ffffff;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 38px;
    font-weight: 900;
}

QLabel#landingHeadline {
    background-color: transparent;
    color: #ffffff;
    font-family: "Figtree", "Segoe UI", "Arial";
    font-size: 34px;
    font-weight: 900;
    line-height: 1.16;
}

QLabel#landingDescription {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.76);
    font-family: "Figtree Light", "Figtree", "Segoe UI Light", "Segoe UI", "Arial";
    font-size: 16px;
    font-weight: 300;
    line-height: 1.45;
}

QLabel#landingSmallText {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.62);
    font-family: "Figtree Light", "Figtree", "Segoe UI Light", "Segoe UI", "Arial";
    font-size: 13px;
    font-weight: 300;
}

QLabel#landingOfferImage {
    background-color: transparent;
    border: none;
}
